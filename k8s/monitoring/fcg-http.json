{
  "uid": "fcg-http",
  "title": "FCG • APIs em operação",
  "description": "UsersAPI e CatalogAPI — tráfego HTTP de negócio (/api). Health e scraping excluídos. Contadores reiniciam com o processo; taxas e p95 usam janela de 2 minutos.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "fiap",
    "fase3"
  ],
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "custom",
        "query": "users-api,catalog-api",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "users-api",
            "value": "users-api"
          },
          {
            "text": "catalog-api",
            "value": "catalog-api"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requisições desde o início do processo",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fcg-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (fcg_http_requests_total{job=~\"$service\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Requisições por status HTTP",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fcg-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job,status_code) (fcg_http_requests_total{job=~\"$service\"})",
          "legendFormat": "{{job}} · {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Latência p95 por rota",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fcg-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job,route,le) (rate(fcg_http_request_duration_seconds_bucket{job=~\"$service\"}[2m])))",
          "legendFormat": "{{job}} · {{route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Taxa de requisições",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fcg-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(fcg_http_requests_total{job=~\"$service\"}[2m]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Erros de servidor (5xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fcg-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by (job) (rate(fcg_http_requests_total{job=~\"$service\",status_code=~\"5..\"}[2m])) or on(job) (0 * sum by (job) (rate(fcg_http_requests_total{job=~\"$service\"}[2m])))) / clamp_min(sum by (job) (rate(fcg_http_requests_total{job=~\"$service\"}[2m])), 0.000001))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Erros de cliente (4xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fcg-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by (job) (rate(fcg_http_requests_total{job=~\"$service\",status_code=~\"4..\"}[2m])) or on(job) (0 * sum by (job) (rate(fcg_http_requests_total{job=~\"$service\"}[2m])))) / clamp_min(sum by (job) (rate(fcg_http_requests_total{job=~\"$service\"}[2m])), 0.000001))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
