  "kind": "Service",
  "metadata": {
    "name": "users-api",
    "labels": {
      "app": "users-api",
      "app.kubernetes.io/name": "users-api",
      "app.kubernetes.io/part-of": "fcg"
    }
  },
  "spec": {
